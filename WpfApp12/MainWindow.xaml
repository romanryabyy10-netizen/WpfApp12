<Window x:Class="WpfApp10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Booking" Height="480" Width="720" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="CHOOSE A HOTEL" FontSize="18"/>
            <ComboBox x:Name="comboboxhotel" SelectionChanged="hotelnirselected">
                <ComboBoxItem Content="Leonardo Club"/>
                <ComboBoxItem Content="Malkat Shva"/>
                <ComboBoxItem Content="Royale Beach"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,5,0">
            <TextBlock Text="CHOOSE AN AREA" FontSize="18"/>
            <ComboBox x:Name="ComboboxArea">
                <ComboBoxItem Content="Downtown"/>
                <ComboBoxItem Content="Beach"/>
                <ComboBoxItem Content="Center"/>
                <ComboBoxItem Content="Airport District"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Text="CHOOSE A COUNTRY" FontSize="18"/>
            <ComboBox x:Name="CommandBoxCountry" >
                <ComboBoxItem Content="United States"/>
                <ComboBoxItem Content="United Kingdom"/>
                <ComboBoxItem Content="France"/>
                <ComboBoxItem Content="Japan"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock x:Name="TextNights" Text="NIGHTS 0" FontSize="18"/>
            <TextBlock x:Name="TextPrice" Text="PRICE: 0$" FontSize="18"/>
            <TextBlock Text="CHOOSE ARRIVAL DATE" FontSize="18" Margin="0,20,0,5"/>
            <Calendar x:Name="CalendarArrival" SelectedDatesChanged="CalendarArrival_SelectedDatesChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,76,0,0">
            <TextBlock Text="CHOOSE LEAVING DATE" FontSize="18" Margin="0,0,0,5"/>
            <Calendar x:Name="CalendarLeave" SelectedDatesChanged="CalendarLeave_SelectedDatesChanged"/>
        </StackPanel>
        <Button Grid.Column="0" Grid.Row="1" VerticalAlignment="Top"  HorizontalAlignment="Left" 
                Width="70" Height="20" Margin="0,49,0,0" Click="malonir">
            <TextBlock Text="checkprice"/>
        </Button>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,0">
            <TextBlock Text="CHOOSE ROOM TYPE" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

            <RadioButton Content="Single" Checked="RoomType_Checked" Margin="0,2"/>
            <RadioButton Content="Double" Checked="RoomType_Checked" Margin="0,2"/>
            <RadioButton Content="Triple" Checked="RoomType_Checked" Margin="0,2"/>
            <RadioButton Content="Family Room" Checked="RoomType_Checked" Margin="0,2"/>

            <TextBlock Text="ROOM TREATS:" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBlock x:Name="TextTreats" Text="Select a room to see treats" FontSize="14" TextWrapping="Wrap" Foreground="Green"/>
        </StackPanel>
    </Grid>
</Window>